{
  "name": "pikagen",
  "private": true,
  "version": "0.1.0",
  "description": "ピカチュウげんきでちゅう風 ファンメイド3Dおさんぽゲーム (Three.js + Capacitor)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "validate": "node scripts/validate-maps.mjs",
    "maps:build": "node scripts/export-maps-json.mjs && python3 tools/blender/build_maps.py",
    "pikachu:build": "python3 tools/blender/build_pikachu.py",
    "android:prepare": "node scripts/prepare-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "vite": "^6.0.0"
  }
}
